{
  "mcpServers": {
    "neo4j": {
      "command": "node",
      "args": [
        "PATH_TO_REPO/mcp/neo4j-server/dist/index.js"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "SET_FROM_ENV",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}
