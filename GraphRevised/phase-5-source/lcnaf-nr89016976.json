"@value": "eng" } ] },  { "@id": "_:b201httpc0liddOtlocdOtgovauthoritiesnamesnr89016976", "@type": [ "http://www.loc.gov/mads/rdf/v1#Source" ], "http://www.loc.gov/mads/rdf/v1#citationStatus": [ { "@value": "found" } ], "http://www.loc.gov/mads/rdf/v1#citationSource": [ { "@value": "Ohio State University website, viewed July, 1, 2019" }, { "@id": "https://oaa.osu.edu/roller-duane" } ], "http://www.loc.gov/mads/rdf/v1#citationNote": [ { "@value": "(Duane Roller received a Ph.D. in Classical Archaeology from Harvard University in 1971; a BA in Letters and MA in Latin from the University of Oklahoma. He has authored over 200 scholarly articles and 14 books. He participated in or directed archaeological excavations and surveys in Greece, Italy, Turkey, Israel, Jordan, and northwestern Africa. His current research is directed largely toward ancient geography and exploration, as well as the role of women in antiquity. After leaving Ohio State in 2007, he was Karl-Franzens Distinguished Professor of Cultural Studies at the University of Graz in Austria, in 2008. He currently lives in Santa Fe, NM, and pursues an active program of research, as well as travels throughout the US giving public lectures, particularly on the topic of Cleopatra and ancient women. Email: roller.2@osu.edu)" } ] },  { "@id": "http://www.wikidata.org/entity/Q12309032", "@type": [ "http://www.loc.gov/mads/rdf/v1#Topic", "http://www.w3.org/2004/02/skos/core#Concept" ], "http://www.loc.gov/mads/rdf/v1#authoritativeLabel": [ { "@value": "Duane W. Roller" } ], "http://www.w3.org/2004/02/skos/core#prefLabel": [ { "@value": "Duane W. Roller" } ] },  { "@id": "_:b193httpc0liddOtlocdOtgovauthoritiesnamesnr89016976", "@type": [ "http://www.loc.gov/mads/rdf/v1#Source" ], "http://www.loc.gov/mads/rdf/v1#citationStatus": [ { "@value": "found" } ], "http://www.loc.gov/mads/rdf/v1#citationSource": [ { "@value": "Cleopatra's Daughter, 2018:" } ], "http://www.loc.gov/mads/rdf/v1#citationNote": [ { "@value": "title pa